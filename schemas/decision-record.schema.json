{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-record.schema.json",
  "title": "Decision Record",
  "type": "object",
  "required": ["case_id", "context", "options", "evidence", "risks", "human_decision", "date"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "ai_recommendation": {"type": "string"},
    "human_decision": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "observed_outcome": {"type": "string"}
  },
  "additionalProperties": false
}
